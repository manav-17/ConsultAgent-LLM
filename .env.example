# Copy this file to .env

LLM_PROVIDER=groq

# Key from console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model (default openai/gpt-oss-120b).
# Use openai/gpt-oss-20b if the 120b daily limit is reached.
# LLM_MODEL=

# Optional: better web search (free tier at tavily.com). Without it, DuckDuckGo is used.
TAVILY_API_KEY=